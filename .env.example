# Copy to .env and edit before deploying.
SECRET_KEY=replace-with-a-long-random-string

# PostgreSQL connection (SQLAlchemy + psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://localhost:5432/nyaykosh
DB_ECHO=false

ADMIN_EMAIL=admin@nyaykosh.in
ADMIN_PASSWORD=changeme123
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Comma-separated list is parsed as JSON by pydantic-settings; use a JSON array:
# CORS_ORIGINS=["http://localhost:3000","https://nyaykosh.in"]
